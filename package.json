{
  "name": "meu-dimdim",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.ts",
    "db:migrate": "knex --knexfile db/knexfile.mjs migrate:latest",
    "db:rollback": "knex --knexfile db/knexfile.mjs migrate:rollback",
    "db:status": "knex --knexfile db/knexfile.mjs migrate:status",
    "android:add": "npm run build:android && cap add android",
    "android:sync": "npm run build:android && cap sync android",
    "android:open": "cap open android",
    "auth:configure": "node scripts/configure-auth.mjs",
    "auth:check": "node scripts/configure-auth.mjs --check",
    "build:android": "tsc -b && vite build --mode android"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@supabase/supabase-js": "^2.119.0",
    "knex": "^3.3.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  }
}
