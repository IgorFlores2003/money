# Front (públicas: vão para o navegador)
VITE_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=
# No app Android o front não está na Vercel: informe a URL publicada da API.
# Na web deixe vazio (usa /api do mesmo domínio).
VITE_API_URL=

# Servidor (funções /api e migrações). NUNCA use VITE_ nestes.
# Supabase → Connect → Transaction pooler (porta 6543).
DATABASE_URL=postgresql://postgres.SEU_PROJECT_REF:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=
# Origens extras liberadas no CORS (separadas por vírgula). O app Android usa https://localhost.
ALLOWED_ORIGINS=https://localhost,capacitor://localhost
