# Front (públicas: vão para o navegador)
VITE_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=
# No app Android a URL da API vem do .env.android (npm run android:sync).
# Na web deixe vazio (usa /api do mesmo domínio).
VITE_API_URL=

# Servidor (funções /api e migrações). NUNCA use VITE_ nestes.
# Supabase → Connect → Transaction pooler (porta 6543).
DATABASE_URL=postgresql://postgres.SEU_PROJECT_REF:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=
# Origens extras liberadas no CORS (separadas por vírgula). O app Android usa https://localhost.
ALLOWED_ORIGINS=https://localhost,capacitor://localhost

# Admin local (npm run auth:configure). Nunca use VITE_ nestes.
# Token de acesso pessoal (supabase.com/dashboard/account/tokens), não a chave anon.
SUPABASE_ACCESS_TOKEN=
# Senha de app do Google (16 letras), não a senha da conta.
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_FROM_EMAIL=seu-email@gmail.com
SMTP_FROM_NAME=Meu DimDim

# Leitura de fotos (Gemini). Lista de modelos separados por vírgula: tenta o próximo se um falhar.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash,gemini-3.5-flash-lite
